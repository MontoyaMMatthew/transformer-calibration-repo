# Copy to .env, replace the repository path, and source with `set -a` enabled.
HF_HOME=/absolute/path/to/transformer-calibration-repo/cache/huggingface
HF_HUB_CACHE=/absolute/path/to/transformer-calibration-repo/cache/huggingface/hub
HF_DATASETS_CACHE=/absolute/path/to/transformer-calibration-repo/cache/huggingface/datasets
TRANSFORMER_CALIBRATION_ARTIFACTS=/absolute/path/to/transformer-calibration-repo/artifacts
MPLCONFIGDIR=/absolute/path/to/transformer-calibration-repo/cache/matplotlib
PIP_CACHE_DIR=/absolute/path/to/transformer-calibration-repo/cache/pip
